+#[test]
+fn crate_recursion_limit_preserves_ordered_head_callbacks() {
+    let f = fixture();
+    let path = f.root.join("engine/src/lib.rs");
+    let original = fs::read_to_string(&path).unwrap();
+    fs::write(&path, format!("#![recursion_limit = \"256\"]\n{original}")).unwrap();
+    let original = source::files(&f.root).unwrap();
+    let report = f.run("check");
+    assert!(
+        report["cargo_stdout"]
+            .as_str()
+            .unwrap()
+            .contains("preserved_closure_errors_and_drop ... ok")
+    );
+    assert_eq!(original, source::files(&f.root).unwrap());
+    assert!(
+        fs::read_to_string(f.out.join("engine/src/lib.rs"))
+            .unwrap()
+            .contains("recursion_limit = \"256\"")
+    );
+    f.replace(
+        "engine/src/boundary.rs",
+        "pub fn run(",
+        "#[unexpanded::attribute]\npub fn run(",
+    );
+    assert_eq!(
+        build_plan(&f.root, &f.mods).unwrap_err().code,
+        "E_UNSUPPORTED_MACRO"
+    );
+}
