+#[test]
+fn head_preserves_body_macros_without_expanding_them() {
+    let f = fixture();
+    f.replace(
+        "engine/src/boundary.rs",
+        "let value = work()?;",
+        "macro_rules! original_work { () => { work()? }; }\n        let value = original_work!();",
+    );
+    let original = source::files(&f.root).unwrap();
+    let report = f.run("check");
+    assert!(
+        report["cargo_stdout"]
+            .as_str()
+            .unwrap()
+            .contains("preserved_closure_errors_and_drop ... ok")
+    );
+    assert_eq!(original, source::files(&f.root).unwrap());
+    // Site rewriting still cannot inspect the macro expansion.
+    f.replace(
+        "mods/alpha/horizon-mixin.toml",
+        "kind=\"HEAD\"",
+        "kind=\"RETURN\"",
+    );
+    assert_eq!(
+        build_plan(&f.root, &f.mods).unwrap_err().code,
+        "E_UNSUPPORTED_MACRO"
+    );
+}
